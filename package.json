{
  "name": "commerce-operations-saas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "_legacy-web"
  ],
  "scripts": {
    "dev": "concurrently -n api,legacy -c blue,green \"npm run dev -w @commerce/backend\" \"npm run dev -w @commerce/legacy-web\"",
    "dev:api": "npm run dev -w @commerce/backend",
    "dev:legacy": "npm run dev -w @commerce/legacy-web",
    "build": "npm run build -w @commerce/backend && npm run build -w @commerce/legacy-web",
    "lint": "npm run lint -w @commerce/backend && npm run lint -w @commerce/legacy-web",
    "test": "npm run test -w @commerce/backend",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "concurrently": "^9.1.2",
    "prisma": "^6.2.1"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "allowScripts": {
    "@prisma/engines@6.2.1": true,
    "prisma@6.2.1": true,
    "argon2@0.41.1": true,
    "unrs-resolver@1.12.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
