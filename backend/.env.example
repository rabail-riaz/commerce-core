# Loaded by NestJS and Prisma when commands run from backend/. Copy to .env.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/commerce_core?schema=public
REDIS_URL=redis://localhost:6379
# At least 32 random characters each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
INTEGRATION_ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:3000
PORT=3001
# Development admin created by the seed script. Never commit real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TENANT_NAME=
SEED_TENANT_SLUG=
# Set to true to overwrite an existing admin password on the next seed run.
SEED_RESET_PASSWORD=false
