    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
