# Used by Docker Compose. Copy to .env and replace every placeholder.
POSTGRES_DB=commerce_core
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/commerce_core?schema=public
REDIS_URL=redis://localhost:6379
# At least 32 random characters each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
INTEGRATION_ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:3000
PORT=3001
