generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  SALES_AGENT
  SUPPORT_AGENT
  OPERATIONS_AGENT
  VIEWER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum IntegrationSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  CANCELLED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURN_REQUESTED
  RETURNED
  FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
  RETURNED
}

enum ReturnStatus {
  RETURN_REQUESTED
  APPROVED
  PICKUP
  SHIPMENT
  RECEIVED
  INSPECTION
  REFUND
  REPLACEMENT
  REJECTED
}

enum EmailProvider {
  GMAIL
  MICROSOFT365
  SMTP
}

enum EmailAccountStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum EmailMessageDirection {
  INBOUND
  OUTBOUND
}

model Tenant {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  status                TenantStatus           @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           Membership[]
  auditLogs             AuditLog[]
  roles                 Role[]
  stores                Store[]
  integrations          Integration[]
  customers             Customer[]
  products              Product[]
  orders                Order[]
  couriers              Courier[]
  courierAccounts       CourierAccount[]
  shipments             Shipment[]
  returns               Return[]
  emailAccounts         EmailAccount[]
  emailThreads          EmailThread[]
  emailMessages         EmailMessage[]
  tickets               SupportTicket[]
  customerNotes         CustomerNote[]
  templates             MessageTemplate[]
  campaigns             Campaign[]
  campaignExecutions    CampaignExecution[]
  automations           Automation[]
  automationExecutions  AutomationExecution[]
  notifications         Notification[]
  whatsappAccounts      WhatsAppAccount[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  featureFlags          FeatureFlag[]
  subscription          TenantSubscription?
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  isEmailVerified Boolean         @default(false)
  isActive        Boolean         @default(true)
  isPlatformAdmin Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  memberships     Membership[]
  refreshTokens   RefreshToken[]
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  ticketMessages  TicketMessage[]
  notifications   Notification[]
}

model Membership {
  id           String         @id @default(cuid())
  tenantId     String
  userId       String
  role         MembershipRole
  roleId       String?
  permissions  String[]       @default([])
  createdAt    DateTime       @default(now())
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedRole Role?          @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
  @@index([tenantId, roleId])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  status      RoleStatus       @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Store {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  status       StoreStatus   @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integrations Integration[]
  products     Product[]
  orders       Order[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model Integration {
  id            String                 @id @default(cuid())
  tenantId      String
  storeId       String?
  provider      String
  status        IntegrationStatus      @default(ACTIVE)
  settings      Json?
  lastSyncedAt  DateTime?
  lastError     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store?                 @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  credential    IntegrationCredential?
  syncLogs      IntegrationSyncLog[]
  webhookEvents WebhookEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, provider])
  @@index([storeId])
}

model IntegrationCredential {
  id            String      @id @default(cuid())
  tenantId      String
  integrationId String
  ciphertext    String
  keyVersion    Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  integration   Integration @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, integrationId])
  @@index([tenantId])
}

model IntegrationSyncLog {
  id              String                @id @default(cuid())
  tenantId        String
  integrationId   String
  syncType        String                @default("MANUAL")
  status          IntegrationSyncStatus
  startedAt       DateTime              @default(now())
  completedAt     DateTime?
  recordsSynced   Int                   @default(0)
  recordsCreated  Int                   @default(0)
  recordsUpdated  Int                   @default(0)
  recordsMissing  Int                   @default(0)
  recordsDiverged Int                   @default(0)
  errorMessage    String?
  integration     Integration           @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, integrationId, startedAt])
  @@index([tenantId, status])
}

model WebhookEvent {
  id            String       @id @default(cuid())
  tenantId      String
  integrationId String?
  provider      String
  externalId    String?
  eventType     String
  payload       Json
  receivedAt    DateTime     @default(now())
  processedAt   DateTime?
  errorMessage  String?
  integration   Integration? @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, integrationId, receivedAt])
  @@index([tenantId, eventType, receivedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model Customer {
  id                    String                 @id @default(cuid())
  tenantId              String
  externalCustomerId    String?
  email                 String?
  firstName             String?
  lastName              String?
  phone                 String?
  status                CustomerStatus         @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses             CustomerAddress[]
  tags                  CustomerTag[]
  score                 CustomerScore?
  orders                Order[]
  emailThreads          EmailThread[]
  notes                 CustomerNote[]
  tickets               SupportTicket[]
  whatsappConversations WhatsAppConversation[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalCustomerId])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
}

model CustomerAddress {
  id           String   @id @default(cuid())
  tenantId     String
  customerId   String
  label        String?
  firstName    String?
  lastName     String?
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
}

model CustomerTag {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  name       String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, customerId, name])
  @@index([tenantId, name])
  @@index([tenantId, customerId])
}

model CustomerScore {
  id                   String   @id @default(cuid())
  tenantId             String
  customerId           String
  score                Int
  manualClassification String?
  breakdown            Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  customer             Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, customerId])
  @@index([tenantId, score])
}

model Product {
  id                String           @id @default(cuid())
  tenantId          String
  externalProductId String?
  storeId           String?
  name              String
  description       String?
  status            ProductStatus    @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store?           @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  variants          ProductVariant[]
  orderItems        OrderItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalProductId])
  @@index([tenantId, status])
  @@index([tenantId, storeId])
  @@index([tenantId, name])
}

model ProductVariant {
  id                String      @id @default(cuid())
  tenantId          String
  productId         String
  externalVariantId String?
  sku               String?
  name              String?
  price             Decimal     @db.Decimal(12, 2)
  currency          String      @default("USD")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  product           Product     @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  orderItems        OrderItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, externalVariantId])
  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@index([tenantId, sku])
}

model Order {
  id                    String                 @id @default(cuid())
  tenantId              String
  storeId               String?
  sourceProvider        String
  externalOrderId       String
  customerId            String?
  subtotalAmount        Decimal                @db.Decimal(12, 2)
  taxAmount             Decimal                @default(0) @db.Decimal(12, 2)
  shippingAmount        Decimal                @default(0) @db.Decimal(12, 2)
  discountAmount        Decimal                @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal                @db.Decimal(12, 2)
  currency              String                 @default("USD")
  paymentStatus         PaymentStatus          @default(PENDING)
  paymentMethod         String?
  paymentReference      String?
  shippingAddress       Json?
  billingAddress        Json?
  status                OrderStatus            @default(PENDING)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                 Store?                 @relation(fields: [tenantId, storeId], references: [tenantId, id], onDelete: Restrict)
  customer              Customer?              @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  shipments             Shipment[]
  returns               Return[]
  emailThreads          EmailThread[]
  tickets               SupportTicket[]
  whatsappConversations WhatsAppConversation[]

  @@unique([tenantId, id])
  @@unique([tenantId, sourceProvider, externalOrderId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, storeId, createdAt])
  @@index([tenantId, sourceProvider, externalOrderId])
}

model Courier {
  id        String           @id @default(cuid())
  tenantId  String
  name      String
  code      String
  status    StoreStatus      @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts  CourierAccount[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model CourierAccount {
  id          String            @id @default(cuid())
  tenantId    String
  courierId   String
  name        String
  credentials Json?
  status      IntegrationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courier     Courier           @relation(fields: [tenantId, courierId], references: [tenantId, id], onDelete: Restrict)
  shipments   Shipment[]

  @@unique([tenantId, id])
  @@unique([tenantId, courierId, name])
  @@index([tenantId, courierId])
  @@index([tenantId, status])
}

model Shipment {
  id                 String                  @id @default(cuid())
  tenantId           String
  orderId            String
  externalShipmentId String?
  courierAccountId   String?
  trackingNumber     String?
  status             ShipmentStatus          @default(PENDING)
  shippedAt          DateTime?
  deliveredAt        DateTime?
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order              Order                   @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  courierAccount     CourierAccount?         @relation(fields: [tenantId, courierAccountId], references: [tenantId, id], onDelete: Restrict)
  statusHistory      ShipmentStatusHistory[]
  return             Return?

  @@unique([tenantId, id])
  @@unique([tenantId, trackingNumber])
  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, courierAccountId])
}

model ShipmentStatusHistory {
  id         String         @id @default(cuid())
  tenantId   String
  shipmentId String
  status     ShipmentStatus
  note       String?
  createdAt  DateTime       @default(now())
  shipment   Shipment       @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, shipmentId, createdAt])
  @@index([tenantId, status, createdAt])
}

model Return {
  id            String                @id @default(cuid())
  tenantId      String
  orderId       String
  shipmentId    String?
  status        ReturnStatus          @default(RETURN_REQUESTED)
  reason        String?
  resolution    String?
  requestedAt   DateTime              @default(now())
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         Order                 @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  shipment      Shipment?             @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Restrict)
  statusHistory ReturnStatusHistory[]

  @@unique([tenantId, id])
  @@unique([tenantId, shipmentId])
  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, status, createdAt])
}

model ReturnStatusHistory {
  id        String       @id @default(cuid())
  tenantId  String
  returnId  String
  status    ReturnStatus
  note      String?
  createdAt DateTime     @default(now())
  return    Return       @relation(fields: [tenantId, returnId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, returnId, createdAt])
  @@index([tenantId, status, createdAt])
}

model EmailAccount {
  id                    String             @id @default(cuid())
  tenantId              String
  emailAddress          String
  displayName           String?
  provider              EmailProvider
  credentialsReference  String?
  credentialsCiphertext String?
  status                EmailAccountStatus @default(DISABLED)
  isDefault             Boolean            @default(false)
  canSend               Boolean            @default(false)
  canReceive            Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  threads               EmailThread[]
  messages              EmailMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, emailAddress])
  @@index([tenantId, provider])
  @@index([tenantId, status])
}

model EmailThread {
  id             String          @id @default(cuid())
  tenantId       String
  emailAccountId String
  subject        String?
  participants   Json?
  lastMessageAt  DateTime?
  customerId     String?
  orderId        String?
  ticketId       String?
  unreadCount    Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailAccount   EmailAccount    @relation(fields: [tenantId, emailAccountId], references: [tenantId, id], onDelete: Cascade)
  messages       EmailMessage[]
  tickets        SupportTicket[]
  customer       Customer?       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)
  order          Order?          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, emailAccountId, lastMessageAt])
  @@index([tenantId, customerId])
  @@index([tenantId, orderId])
  @@index([tenantId, ticketId])
}

model EmailMessage {
  id                String                @id @default(cuid())
  tenantId          String
  emailAccountId    String
  threadId          String
  providerMessageId String?
  direction         EmailMessageDirection
  fromAddress       String
  toAddresses       Json
  ccAddresses       Json?
  bccAddresses      Json?
  subject           String?
  textBody          String?
  htmlBody          String?
  sentAt            DateTime?
  receivedAt        DateTime?
  isRead            Boolean               @default(false)
  createdAt         DateTime              @default(now())
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailAccount      EmailAccount          @relation(fields: [tenantId, emailAccountId], references: [tenantId, id], onDelete: Cascade)
  thread            EmailThread           @relation(fields: [tenantId, threadId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, emailAccountId, providerMessageId])
  @@index([tenantId, threadId, createdAt])
  @@index([tenantId, emailAccountId, sentAt])
  @@index([tenantId, threadId, isRead])
}

model OrderItem {
  id          String          @id @default(cuid())
  tenantId    String
  orderId     String
  productId   String?
  variantId   String?
  name        String
  sku         String?
  quantity    Int
  unitAmount  Decimal         @db.Decimal(12, 2)
  totalAmount Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())
  order       Order           @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  product     Product?        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@index([tenantId, productId])
  @@index([tenantId, variantId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  tenantId  String
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, status, createdAt])
}

enum TicketStatus {
  OPEN
  PENDING
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TemplateChannel {
  EMAIL
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

enum AutomationStatus {
  ACTIVE
  INACTIVE
}

enum NotificationStatus {
  UNREAD
  READ
}

enum WhatsAppAccountStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

model CustomerNote {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  body       String
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
}

model SupportTicket {
  id                     String                @id @default(cuid())
  tenantId               String
  customerId             String?
  orderId                String?
  emailThreadId          String?
  whatsappConversationId String?
  assigneeId             String?
  subject                String
  status                 TicketStatus          @default(OPEN)
  priority               TicketPriority        @default(NORMAL)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer               Customer?             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)
  order                  Order?                @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: SetNull)
  assignee               User?                 @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages               TicketMessage[]
  emailThread            EmailThread?          @relation(fields: [tenantId, emailThreadId], references: [tenantId, id], onDelete: SetNull)
  whatsappConversation   WhatsAppConversation? @relation(fields: [tenantId, whatsappConversationId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, orderId])
  @@index([tenantId, assigneeId])
  @@index([tenantId, emailThreadId])
  @@index([tenantId, whatsappConversationId])
}

model TicketMessage {
  id        String        @id @default(cuid())
  tenantId  String
  ticketId  String
  authorId  String?
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId, createdAt])
}

model MessageTemplate {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  channel   TemplateChannel
  provider  String?
  subject   String?
  body      String
  variables String[]        @default([])
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([tenantId, id])
  @@unique([tenantId, name, channel])
  @@index([tenantId, channel, isActive])
}

model Campaign {
  id          String              @id @default(cuid())
  tenantId    String
  name        String
  channel     TemplateChannel
  templateId  String?
  audience    Json?
  status      CampaignStatus      @default(DRAFT)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  result      Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template    MessageTemplate?    @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: SetNull)
  executions  CampaignExecution[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
}

model CampaignExecution {
  id           String         @id @default(cuid())
  tenantId     String
  campaignId   String
  status       CampaignStatus
  sentCount    Int            @default(0)
  failedCount  Int            @default(0)
  errorMessage String?
  createdAt    DateTime       @default(now())
  campaign     Campaign       @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, campaignId, createdAt])
}

model Automation {
  id           String                @id @default(cuid())
  tenantId     String
  name         String
  trigger      String
  action       String
  delayMinutes Int                   @default(0)
  templateId   String?
  status       AutomationStatus      @default(ACTIVE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, trigger])
}

model AutomationExecution {
  id           String     @id @default(cuid())
  tenantId     String
  automationId String
  entityId     String?
  status       String
  attempts     Int        @default(0)
  scheduledAt  DateTime?
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime   @default(now())
  automation   Automation @relation(fields: [tenantId, automationId], references: [tenantId, id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, automationId, createdAt])
}

model Notification {
  id         String             @id @default(cuid())
  tenantId   String
  userId     String?
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  status     NotificationStatus @default(UNREAD)
  createdAt  DateTime           @default(now())
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId, status, createdAt])
}

model WhatsAppAccount {
  id                    String                 @id @default(cuid())
  tenantId              String
  displayName           String
  phoneNumberId         String
  businessAccountId     String?
  credentialsCiphertext String?
  status                WhatsAppAccountStatus  @default(DISABLED)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations         WhatsAppConversation[]
  messages              WhatsAppMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, phoneNumberId])
  @@index([tenantId, status])
}

model WhatsAppConversation {
  id            String            @id @default(cuid())
  tenantId      String
  accountId     String
  customerPhone String
  customerId    String?
  orderId       String?
  unreadCount   Int               @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account       WhatsAppAccount   @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Cascade)
  customer      Customer?         @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)
  order         Order?            @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: SetNull)
  messages      WhatsAppMessage[]
  tickets       SupportTicket[]

  @@unique([tenantId, id])
  @@unique([tenantId, accountId, customerPhone])
  @@index([tenantId, accountId, lastMessageAt])
}

model WhatsAppMessage {
  id                String                @id @default(cuid())
  tenantId          String
  accountId         String
  conversationId    String
  providerMessageId String?
  direction         EmailMessageDirection
  body              String
  mediaType         String?
  mediaReference    String?
  templateName      String?
  status            String?
  createdAt         DateTime              @default(now())
  account           WhatsAppAccount       @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Cascade)
  conversation      WhatsAppConversation  @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, accountId, providerMessageId])
  @@index([tenantId, conversationId, createdAt])
}

model Plan {
  id                  String               @id @default(cuid())
  name                String               @unique
  maxStores           Int                  @default(1)
  maxUsers            Int                  @default(5)
  maxOrdersPerMonth   Int                  @default(500)
  maxCustomers        Int                  @default(1000)
  maxWhatsAppMessages Int                  @default(500)
  maxEmailVolume      Int                  @default(500)
  maxCouriers         Int                  @default(2)
  maxAutomations      Int                  @default(3)
  maxReports          Int                  @default(5)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  subscriptions       TenantSubscription[]
  featureFlags        FeatureFlag[]
}

model TenantSubscription {
  id            String             @id @default(cuid())
  tenantId      String             @unique
  planId        String
  status        SubscriptionStatus @default(TRIAL)
  trialStartsAt DateTime           @default(now())
  trialEndsAt   DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status, trialEndsAt])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String
  enabled   Boolean  @default(false)
  tenantId  String?
  planId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      Plan?    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([key, tenantId, planId])
  @@index([key, enabled])
}
